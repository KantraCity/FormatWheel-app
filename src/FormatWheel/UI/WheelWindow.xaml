<Window x:Class="FormatWheel.WheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Format Wheel"
        Width="380" Height="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        AllowDrop="True" Focusable="False" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid>
        <!-- альфа 1/255: глазом не видно, но Windows считает окно целью для драга.
             Полностью прозрачные пиксели мышь пропускают насквозь. -->
        <Ellipse x:Name="HitArea" Width="340" Height="340" Fill="#01000000" />

        <Grid x:Name="WheelContent" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ContentScale" ScaleX="0.15" ScaleY="0.15" />
                    <RotateTransform x:Name="ContentRotate" Angle="-120" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.45" Color="#000000" Direction="270" />
            </Grid.Effect>

            <Ellipse Width="378" Height="378">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00608BFF" Offset="0.68" />
                        <GradientStop Color="#2E6E8BFF" Offset="0.84" />
                        <GradientStop Color="#00A78BFA" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="338" Height="338" StrokeThickness="1">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.35" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#F221242B" Offset="0" />
                        <GradientStop Color="#F016181E" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#33FFFFFF" Offset="0" />
                        <GradientStop Color="#0AFFFFFF" Offset="0.5" />
                        <GradientStop Color="#1F000000" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>

            <Canvas x:Name="PetalCanvas" Width="380" Height="380" />

            <Ellipse Width="118" Height="118" StrokeThickness="1.2">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.3">
                        <GradientStop Color="#FF1B1E26" Offset="0" />
                        <GradientStop Color="#FF131519" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                        <GradientStop Color="#99A78BFA" Offset="0" />
                        <GradientStop Color="#663B82F6" Offset="0.5" />
                        <GradientStop Color="#5538BDF8" Offset="1" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
            <Ellipse x:Name="CenterThumb" Width="104" Height="104" Fill="#12FFFFFF" />
            <Ellipse x:Name="CenterShade" Width="104" Height="104" Opacity="0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#00000000" Offset="0.55" />
                        <GradientStop Color="#99000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- подписи клавиш Shift / Ctrl / Alt: зажатые подсвечены — видно, какое меню откроется -->
            <StackPanel x:Name="KeyChips" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,26,0,0" IsHitTestVisible="False" Opacity="0" />

            <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,2"
                    CornerRadius="14" Padding="14,4,14,5" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F01E212A" Offset="0" />
                        <GradientStop Color="#F0141620" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2EFFFFFF" Offset="0" />
                        <GradientStop Color="#0FFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <TextBlock x:Name="PillText" Foreground="#F2FFFFFF" FontSize="12" FontWeight="Medium" MaxWidth="300" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
