<Window x:Class="FormatWheel.DragGhostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FormatWheel"
        Title="Format Wheel drag"
        Width="220" Height="210"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Focusable="False" IsHitTestVisible="False" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <!-- курсор в точке (40, 40): кольцо вокруг него, карточка справа снизу -->
    <Canvas x:Name="Root" Opacity="0">
        <Ellipse Canvas.Left="28" Canvas.Top="28" Width="24" Height="24" Fill="#4D101216" />
        <local:ProgressRing x:Name="Ring" Canvas.Left="28" Canvas.Top="28" Width="24" Height="24" Thickness="2.5" />

        <!-- тень карточки — градиентная подложка, а не DropShadowEffect: размытие пересчитывалось
             при каждом изменении процентов и на слабых ПК тормозило перетаскивание -->
        <Border Canvas.Left="54" Canvas.Top="58" Width="144" Height="148" CornerRadius="20" IsHitTestVisible="False">
            <Border.Background>
                <RadialGradientBrush RadiusX="0.55" RadiusY="0.55">
                    <GradientStop Color="#73000000" Offset="0.6" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <Border x:Name="Card" Canvas.Left="58" Canvas.Top="56" Width="136"
                CornerRadius="16" BorderThickness="1" Padding="6"
                RenderTransformOrigin="0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#EC1E212A" Offset="0" />
                    <GradientStop Color="#EC141620" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33FFFFFF" Offset="0" />
                    <GradientStop Color="#10FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <StackPanel>
                <Grid Height="96">
                    <Border x:Name="Thumb" CornerRadius="9" Background="#1AFFFFFF" />
                    <Border x:Name="CountBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"
                            CornerRadius="7" Padding="6,1" Background="#CC101216" Visibility="Collapsed">
                        <TextBlock x:Name="CountText" Foreground="White" FontSize="10.5" FontWeight="SemiBold" />
                    </Border>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" CornerRadius="7" Padding="7,2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A78BFA" Offset="0" />
                                <GradientStop Color="#3B82F6" Offset="0.5" />
                                <GradientStop Color="#38BDF8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock x:Name="BadgeText" Foreground="White" FontSize="11" FontWeight="Bold" />
                    </Border>
                </Grid>
                <DockPanel Margin="3,6,3,1" LastChildFill="True">
                    <TextBlock x:Name="Percent" DockPanel.Dock="Right" Foreground="White" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="Status" Foreground="#B3FFFFFF" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
